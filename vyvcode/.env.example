# ── Providers ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME                  # Communicator (gpt-5.6-sol)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME           # MasterPlanner + Reviewer
MOONSHOT_API_KEY=sk-REPLACE_ME                # Coder swarm (kimi-k3), api.moonshot.ai
OPENROUTER_API_KEY=                           # optional fallback routing, unused by default

# ── Model routing (override any role without touching code) ─────────────────
VYVCODE_COMMUNICATOR_MODEL=gpt-5.6-sol
VYVCODE_COMMUNICATOR_EFFORT=xhigh
VYVCODE_PLANNER_MODEL=anthropic/claude-fable-5
VYVCODE_PLANNER_EFFORT=max
VYVCODE_CODER_MODEL=openai/kimi-k3
VYVCODE_CODER_BASE_URL=https://api.moonshot.ai/v1
VYVCODE_CODER_EFFORT=max
VYVCODE_REVIEWER_MODEL=anthropic/claude-opus-5   # if provider rejects: anthropic/claude-fable-5
VYVCODE_REVIEWER_EFFORT=xhigh

# ── Orchestration knobs ──────────────────────────────────────────────────────
VYVCODE_MAX_PARALLEL_CODERS=4
VYVCODE_MAX_REVIEW_CYCLES=5
VYVCODE_PLAN_GATE=false                # true = pause after MasterPlan.md for user "go"
VYVCODE_OPTIMIZER_MIN_TOKENS=60        # inputs shorter than this skip rewriting
VYVCODE_GRILL_ROUNDS_PLAN=4
VYVCODE_GRILL_ROUNDS_GOAL=2
VYVCODE_CODER_MAX_ITER=200             # per-phase iteration cap (maps to max_iteration_per_run)
VYVCODE_CODER_MAX_BUDGET=              # optional $ cap per phase (maps to max_budget_per_run)

# ── Memory (memsearch) ───────────────────────────────────────────────────────
VYVCODE_MEMORY=true
# memsearch embeds locally via ONNX by default (no key needed). To use OpenAI
# embeddings instead, configure memsearch's config with api_key: "env:OPENAI_API_KEY".
